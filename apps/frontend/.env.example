# Build-time API base URL for the SPA.
#
# In the all-in-one Docker topology this stays at the default "/api" (relative).
# In the split topology (Vercel frontend + self-hosted backend) set this to
# the public origin of your backend, e.g.:
#   VITE_DISPATCH_API_URL=https://api.example.com
#
# When the backend is behind Cloudflare Access, the SPA will automatically
# send cookies via credentials: "include" — just make sure the Access
# application covers both the frontend and backend origins.
VITE_DISPATCH_API_URL=/api
