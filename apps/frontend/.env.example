# =============================================================================
# Dispatch Vercel Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values.
# See docs/operations/vercel-env-setup.md for step-by-step instructions.
# =============================================================================

# Auth — encrypts settings at rest (same as backend DISPATCH_MASTER_KEY)
DISPATCH_MASTER_KEY=

# Database — Turso serverless SQLite (create via `turso db create dispatch`)
TURSO_DATABASE_URL=libsql://dispatch-<user>.turso.io
TURSO_AUTH_TOKEN=

# Primary LLM — Kimi For Coding (free with Kimi membership)
# Get key at: https://www.kimi.com/coding/docs/en/third-party-agents.html
KIMI_API_KEY=

# Fallback LLM — Gemini 2.5 Flash (free tier: 5 RPM, 100 RPD)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback LLM — Groq Llama 3.3 70B (free tier: 14,400 RPD, 30 RPM)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# TTS — OpenAI (direct, no backend required)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Optional: URL of the self-hosted backend (only needed for podcasts)
BACKEND_URL=https://dispatch-demo-api.marklab.uk

# Storage — Cloudflare R2 (S3-compatible)
# Account ID is your Cloudflare account identifier
R2_ACCOUNT_ID=7f5bbe163c03ce3b41590ff227ff6842
# S3 tokens: create at Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dispatch-media
# Public base URL for serving files (account hash .r2.dev or custom domain)
R2_PUBLIC_BASE_URL=https://7f5bbe163c03ce3b41590ff227ff6842.r2.dev

# GitHub — personal access token for repo/ingest (classic or fine-grained)
GITHUB_TOKEN=

# Podcast proxy — URL of the self-hosted Docker backend (only for podcasts)
# If not set, falls back to BACKEND_URL
PODCAST_BACKEND_URL=https://dispatch-podcast.yourdomain.com

# Optional: timezone for cron scheduling
DISPATCH_TZ=Asia/Manila

# Show a "Open source on GitHub" footer link on the home page
VITE_SHOW_GITHUB_LINK=false
