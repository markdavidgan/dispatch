{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/proxy/(.*)", "destination": "/api/proxy/$1" },
    { "source": "/api/(.*)", "destination": "https://dispatch-api.marklab.uk/api/$1" },
    { "source": "/health", "destination": "https://dispatch-api.marklab.uk/health" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
