# Required: encrypts all settings at rest. The app refuses to boot without it.
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DISPATCH_MASTER_KEY=

# Optional: defaults are sensible for local dev.
HOST=127.0.0.1
PORT=10060
DB_PATH=./dispatch.dev.db
DISPATCH_TZ=Asia/Manila

# --- The following can also be configured via the admin UI (/admin/settings). ---
# Env vars are still supported for bootstrapping and local dev convenience.

# AI synthesis provider (kimi | gemini | groq):
# DISPATCH_AI_PROVIDER=kimi

# Kimi For Coding — get API key at https://www.kimi.com/coding/docs/en/third-party-agents.html
# KIMI_API_KEY=

# Gemini — get key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Groq — get key at https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Legacy Anthropic fallback (optional):
# ANTHROPIC_API_KEY=

# Google Cloud TTS:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/gcp-sa.json
# GCP_TTS_VOICE=en-US-Chirp3-HD-Leda

# GitHub ingest:
# GITHUB_TOKEN=

# Cloudflare R2 (snapshot + audio storage — also configurable via admin UI):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# CORS origins for split deployments (comma-separated).
# Required when the SPA is hosted on a different origin than the backend
# (e.g. Vercel frontend + self-hosted backend behind Cloudflare Access).
# DISPATCH_CORS_ORIGINS=https://app.example.com

# NotebookLM (podcast composition):
# NOTEBOOKLM_AUTH_JSON=
